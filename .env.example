# Copia este archivo a .env y rellena lo que vayas a usar.
# .env esta en .gitignore: NUNCA se versiona. No pegues claves en el chat.

# --- LLM para generacion + verificador (proveedor intercambiable) ---
# Por defecto: OpenAI. openai Pon "anthropic" para usar Claude.
LLM_PROVIDER=anthropic 
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos por rol (opcional; si se dejan vacios se usan los defaults del proveedor):
#   openai    -> router=gpt-4o-mini, sintesis=gpt-4o, verificador=gpt-4o
#   anthropic -> router=claude-haiku-4-5, sintesis=claude-sonnet-4-6, verificador=claude-opus-4-8
MODELO_ROUTER=claude-haiku-4-5
MODELO_SINTESIS=claude-sonnet-4-6
MODELO_VERIFICADOR=claude-opus-4-8
# --- Embeddings densos (Anthropic no ofrece embeddings) ---
# Por defecto: OpenAI. Pon "voyage" solo si quieres usar Voyage.
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBED_MODELO=text-embedding-3-large
# Alternativa opcional (Voyage AI):
VOYAGE_API_KEY=
VOYAGE_MODELO=voyage-3.5

# --- LangSmith (trazas + datasets de evaluacion) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=asistente-vih-gesida
LANGSMITH_DATASET=gesida-banco-505
